<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; transform-origin: center; height: 100%; width: 100%;">
        <ui:ScrollView name="ScrollView" style="height: 100%; width: 40%; top: 0; bottom: 0; flex-grow: 1;"/>
        <ui:TextField name="TextField" label="Text Field" placeholder-text="filler text"/>
    </ui:VisualElement>
    <ui:Button text="TestButton" name="Button" style="position: absolute; left: 45%; top: 48%; width: 140px; height: 32px;"/>
</ui:UXML>
