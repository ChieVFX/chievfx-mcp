{
  "name": "reflection-method-find-single",
  "description": "Returns full info for one reflection-method-find result selected by page-local index.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "outputFormat": {
        "$chievfxSchema": "outputFormat"
      },
      "filter": {
        "$chievfxSchema": "methodRef"
      },
      "match": {
        "type": "string",
        "enum": [
          "exact",
          "contains"
        ],
        "default": "exact"
      },
      "maxResults": {
        "type": "integer",
        "default": 10
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "default": 1
      },
      "index": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "filter",
      "index"
    ]
  }
}
