{
  "name": "asset-find",
  "description": "Find project assets by name, type, label, folder, area (+ optional subassets). Returns compact rows with asset-detail URIs.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "outputFormat": {
        "$chievfxSchema": "outputFormat"
      },
      "name": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "description": "Name terms (whitespace-separated terms are ANDed)."
      },
      "type": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "description": "Type or alias: material, texture, prefab, scene, mesh, renderTexture, object, or a Unity class name."
      },
      "label": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "area": {
        "type": "string",
        "enum": [
          "assets",
          "packages",
          "all"
        ]
      },
      "folder": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "description": "Project-relative folder(s) to search."
      },
      "includeSubassets": {
        "type": "boolean"
      },
      "subassets": {
        "type": "boolean"
      },
      "maxResults": {
        "type": "integer"
      },
      "limit": {
        "type": "integer"
      }
    }
  }
}
