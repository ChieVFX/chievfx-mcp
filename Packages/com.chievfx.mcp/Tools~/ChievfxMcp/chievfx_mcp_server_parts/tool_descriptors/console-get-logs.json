{
  "name": "console-get-logs",
  "description": "Recent Unity Console entries. Filter severity with levels. Exact contains values error/exception/warning/issue are severity filters, not text search.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "outputFormat": {
        "$chievfxSchema": "outputFormat"
      },
      "maxEntries": {
        "type": "integer"
      },
      "levels": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Error",
            "Assert",
            "Warning",
            "Log",
            "Exception",
            "ConsoleErrors",
            "ConsoleIssues"
          ]
        }
      },
      "contains": {
        "type": "string"
      },
      "stack": {
        "type": "boolean",
        "default": true
      },
      "lastMinutes": {
        "type": "integer"
      }
    }
  }
}
