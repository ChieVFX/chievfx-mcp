{
  "name": "frame-debugger-group-events-list",
  "description": "Lists draw calls/events inside one Frame Debugger group by groupIndex.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "outputFormat": {
        "$chievfxSchema": "outputFormat"
      },
      "open": {
        "type": "boolean",
        "default": true
      },
      "focus": {
        "type": "boolean",
        "default": false
      },
      "groupIndex": {
        "type": "integer",
        "minimum": 0
      },
      "startIndex": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "maxResults": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      }
    },
    "required": [
      "groupIndex"
    ]
  }
}
